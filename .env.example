# Local: docker compose up -d  |  Supabase: Project Settings > Database > Connection string (Session pooler)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/evtech
PAYLOAD_SECRET=change-me-long-random-string

# Supabase Storage (bỏ trống S3_BUCKET = lưu ảnh ở ./media trên ổ đĩa)
# Dashboard > Storage > tạo bucket "media" (Public) ; Storage > S3 Configuration > New access key
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket public: ảnh tải thẳng từ CDN Supabase
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# Domain chính thức (dùng cho canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://evtech.vn

# Staging/preview (vd *.vercel.app): chặn Google index
# NOINDEX=1
